# Copy to .env. telemetry_node reads it from the working directory and does not
# override variables that are already set in the environment.

TN_UART_LINK=/tmp/telemetry-node-uart
TN_UART_BAUD=115200
TN_NODE_ID=1

# Serve the same byte stream on a TCP port instead of a pty symlink:
# TN_UART_LINK=tcp://0.0.0.0:8765
